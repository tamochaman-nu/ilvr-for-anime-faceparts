# .env にコピーして各自の環境に合わせる (.env は git 管理外)

# アニメ目の学習データ (32x32 の目クロップ。C4 の統計比較と Phase 3 の KID に使う)
HOST_ANIME_EYE_DIR=/path/to/danbooru_work/parts-32/eye
# 実写の目クロップ (ILVR の参照画像。学習データと同じ切り出しスクリプトで作ったもの)
HOST_REAL_EYE_DIR=/path/to/ffhq512x512-parts/32/eye
# 実写の目の切り出し時のスコア (make-ref-lists で参照画像の選別に使う)
HOST_REAL_EYE_PARTS_JSONL=/path/to/ffhq512x512-parts/32/parts.jsonl
# 実写の目のマスク (切り出し時の楕円をぼかしたもの。Step 3 のマスク付き ILVR で使う)
HOST_REAL_EYE_MASK_DIR=/path/to/ffhq512x512-parts/32/eye_mask
# check-compat で比較する学習フォーク (tamochaman-nu/guided-diffusion の dev/detect-resblock-overflow)
HOST_FORK_DIR=/path/to/guided-diffusion-ilvr-eye

# 目DDPM のチェックポイントと、学習時に保存された設定 (リポジトリからの相対パス)。
# EMA 0.9999 版を使う (非 EMA 版・EMA 0.9995 版との比較: outputs/step1_ema/metrics.csv)
MODEL_PATH=ddpm/anime-eye32-mp64-ema_0.9999_200000.pt
MODEL_CFG=ddpm/anime-eye32-mp64.cfg

# 使う GPU 番号
GPU_ID=0

# ベースイメージ (ホストのドライバが対応する CUDA 以下を選ぶ) と、CUDA 違いのイメージを区別するタグ
BASE_IMAGE=pytorch/pytorch:2.4.1-cuda12.4-cudnn9-devel
IMAGE_TAG=latest

# コンテナを実行するホストのユーザー (id -u / id -g の値)
HOST_UID=1000
HOST_GID=1000
